{
  "expo": {
    "name": "Stash",
    "slug": "stubs",
    "scheme": "stubs",
    "version": "0.4.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.jesjg.stash",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.security.application-groups": [
          "group.com.jesjg.stash",
          "group.com.jesjg.stash"
        ]
      }
    },
    "android": {
      "package": "com.jesjg.stash",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#EDEDE9"
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.jesjg.stash",
            "activationRule": {
              "supportsImageWithMaxCount": 10,
              "supportsFileWithMaxCount": 5,
              "supportsWebUrlWithMaxCount": 1,
              "supportsText": true
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "image/*",
              "text/plain"
            ],
            "multipleShareMimeTypes": [
              "image/*"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF5A1F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stash uses your photos so you can add ticket screenshots, and to spot new screenshots that contain a ticket code. Nothing leaves your phone.",
          "cameraPermission": "Stash uses the camera to scan paper tickets. Photos stay on your phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Stash uses your photos so you can add ticket screenshots, and to spot new screenshots that contain a ticket code. Nothing leaves your phone.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.jesjg.stash.widgets",
          "groupIdentifier": "group.com.jesjg.stash",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "NextTicket",
              "displayName": "Next ticket",
              "description": "Your next ticket and how long to go.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Stash uses motion so holographic tickets shimmer as you tilt your phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/dce554aa-af0b-497b-b083-fc58dd9a8d01"
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "com.jesjg.stash.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jesjg.stash"
                    ]
                  }
                },
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.jesjg.stash.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jesjg.stash"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "dce554aa-af0b-497b-b083-fc58dd9a8d01"
      }
    },
    "owner": "jesjg"
  }
}
